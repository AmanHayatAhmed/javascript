/*Problem statement

Write a JavaScript function that checks whether a phone number is valid.
A phone number is valid if:
1. It contains exactly 10 digits.
2. Its first digit is 7, 8, or 9.
Return true if both conditions are satisfied; otherwise, return false.
Input	Expected output
"9876543210"	true
"7123456789"	true
"6123456789"	false
"987654321"	false*/

const numValid = (phoneNum) => {
    let StrNum = phoneNum.toString()
    
    if(StrNum.length === 10){
        if(StrNum[0] == 7 || StrNum[0] == 8 || StrNum[0] == 9){
            return true
        }
        else{
            return false
        }
    }
    else {
        return false
    }

}

 let numChecker = numValid(2489329482);
 console.log(numChecker);

console.log(numValid(987654321))
